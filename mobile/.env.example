# Copiar este archivo a mobile/.env y reiniciar Expo (npx expo start -c).

# URL base de la API REST, incluyendo /api.
# En un teléfono con Expo Go no sirve "localhost": usar la IP local del computador
# que ejecuta el backend (ipconfig en Windows), en la misma red Wi-Fi.
# En el emulador de Android se puede usar http://10.0.2.2:3000/api
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api
