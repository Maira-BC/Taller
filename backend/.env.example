# Variables del backend. Copiar este archivo a backend/.env y ajustar los valores.
# Los datos de conexión coinciden con docker-compose.yml (docker compose up -d).

# Puerto de la API REST (Swagger en http://localhost:3000/docs)
PORT=3000

# PostgreSQL: usuario taller, contraseña taller, base turnos
DATABASE_URL=postgres://taller:taller@localhost:5432/turnos

# MongoDB: colección de eventos de cada turno
MONGO_URL=mongodb://localhost:27017/turnos

# Clave para firmar los tokens JWT de los funcionarios (usar un valor largo y aleatorio)
JWT_SECRET=cambiar-por-una-clave-secreta
