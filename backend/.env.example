# COPIAR A backend/.env Y AJUSTAR CON VARIABLES LOCALES.
# Puerto de la API REST (Swagger en http://localhost:3000/docs)
PORT=3000

# PostgreSQL: usuario taller, contraseña taller, base turnos
DATABASE_URL=postgres://taller:taller@localhost:5432/turnos

# BASE MONGO (EVENTOS?)
MONGO_URL=mongodb://localhost:27017/turnos

#CLAVE TOKEN (CAMBIA R POR CLAVE SERCRETA)
JWT_SECRET=cambiar-por-una-clave-secreta

